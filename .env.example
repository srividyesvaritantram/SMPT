# ── Frontend Environment Variables ───────────────────────────────────────────
# Copy this file to .env.local for local development
# For production, add these as GitHub Secrets (Settings → Secrets → Actions)
#
# All Vite env vars MUST start with VITE_ to be exposed to the browser.

# URL of your backend API
# Development:  http://localhost:8080/api
# Production:   https://api.yourdomain.com/api  (or your Hostinger backend URL)
VITE_API_BASE_URL=http://localhost:8080/api
