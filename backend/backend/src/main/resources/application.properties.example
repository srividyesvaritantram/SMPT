# ── Copy this file to application.properties and fill in real values ──────────
# OR set these as environment variables on your server.

server.port=8080

# ── Database ──────────────────────────────────────────────────────────────────
# Development (H2 in-memory):
spring.datasource.url=jdbc:h2:mem:srimahavidyesvari;DB_CLOSE_DELAY=-1
spring.datasource.driver-class-name=org.h2.Driver
spring.datasource.username=sa
spring.datasource.password=
spring.jpa.database-platform=org.hibernate.dialect.H2Dialect
spring.jpa.hibernate.ddl-auto=create-drop
spring.h2.console.enabled=true
spring.h2.console.path=/h2-console

# Production (MySQL example):
# spring.datasource.url=jdbc:mysql://localhost:3306/srimahavidyesvari
# spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver
# spring.datasource.username=YOUR_DB_USER
# spring.datasource.password=YOUR_DB_PASSWORD
# spring.jpa.database-platform=org.hibernate.dialect.MySQLDialect
# spring.jpa.hibernate.ddl-auto=update

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate a strong random base64 string (min 32 chars) for production
app.jwt.secret=YOUR_STRONG_SECRET_KEY_HERE
app.jwt.expiration-ms=86400000

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
app.cors.allowed-origins=https://yourdomain.com,http://localhost:5173
